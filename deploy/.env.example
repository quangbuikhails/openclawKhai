# Mẫu ~/apps/openclaw/.env của dự án (D19). Không điền giá trị thật vào tệp này.
COMPOSE_PROJECT_NAME=khai-pbs
OPENCLAW_GATEWAY_PORT=28789
OPENCLAW_BRIDGE_PORT=28790
OPENCLAW_MSTEAMS_PORT=28978
OPENCLAW_TZ=Asia/Ho_Chi_Minh
# Khi chạy thật phải cố định theo digest, không để latest: xem deploy/README.md.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
OPENCLAW_GATEWAY_TOKEN=<ĐIỀN_TOKEN>

# Mẫu secrets/mcp-google.env của repo (gitignore, không phải tệp này; G2-01B). Chỉ container khai-mcp-google đọc.
# MCP_GOOGLE_TOKEN=<openssl rand -hex 32>
# TEST_SPREADSHEET_ID=<ID bảng tính [TEST]>
# TEST_CALENDAR_ID=<ID lịch [TEST]>
# Khóa Service Account: secrets/google-sa.json (mount :ro vào container này, không đặt ở đây).
