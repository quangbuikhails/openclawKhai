# Mẫu ~/apps/openclaw/.env của dự án (D19). Không điền giá trị thật vào tệp này.
COMPOSE_PROJECT_NAME=khai-pbs
OPENCLAW_GATEWAY_PORT=28789
OPENCLAW_BRIDGE_PORT=28790
OPENCLAW_MSTEAMS_PORT=28978
OPENCLAW_TZ=Asia/Ho_Chi_Minh
# Khi chạy thật phải cố định theo digest, không để latest: xem deploy/README.md.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
OPENCLAW_GATEWAY_TOKEN=<ĐIỀN_TOKEN>

# Mẫu secrets/mcp-google.env của repo (gitignore, không phải tệp này; G2-01B). Chỉ container khai-mcp-google đọc.
# MCP_GOOGLE_TOKEN=<openssl rand -hex 32>
# BRIEF_TOKEN=<openssl rand -hex 32>   # tùy chọn, khác MCP_GOOGLE_TOKEN, từ 32 ký tự; thiếu thì /brief/*, /sync/* tắt (G2-06b)
# SPREADSHEET_ID=<ID bảng tính>
# CALENDAR_ID=<ID lịch>
# SHEET_MODE=test   # test (mặc định) hoặc prod; phải khớp tên bảng tính: test cần tên bắt đầu [TEST], prod thì không
# CAL_MODE=test     # như trên, theo tên lịch; prod hiện chỉ cho đọc (luật ghi chờ G2-05, G2-06)
# Máy chủ không khởi động (thoát mã 1) khi chế độ không khớp tên, hoặc tiêu đề trang bieu, log không đúng 14 cột / 5 cột.
# Khóa Service Account: secrets/google/google-sa.json (mount thư mục :ro vào container này, không đặt ở đây).

# Mẫu secrets/mcp-kho.env của repo (gitignore, không phải tệp này; G5-03, D56). Chỉ container khai-mcp-kho đọc.
# MCP_KHO_TOKEN=<openssl rand -hex 32>   # khác MCP_GOOGLE_TOKEN, BRIEF_TOKEN, WEB_TOKEN; thiếu hoặc dưới 32 ký tự thì server thoát mã 1
# KHO_SPREADSHEET_ID=<ID bảng "Khải Phiên Bản Số – Kho số liệu">   # thiếu thì chỉ kho_so_lieu báo lỗi
# Khóa Service Account chỉ đọc riêng: secrets/google-kho/google-kho-sa.json (mount thư mục :ro, không đặt ở đây).
